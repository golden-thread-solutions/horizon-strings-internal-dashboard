# Local synthetic-data preview only. Ignored in production and when Supabase is configured.
DASHBOARD_DEMO_MODE=true

# Supabase Settings > API / API Keys. Publishable (sb_publishable_...) or legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Do not put a Supabase secret/service-role key in this application.
# Owner sessions and row-level security protect all data operations.

