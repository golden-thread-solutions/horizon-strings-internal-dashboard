# Local app mode
NEXT_PUBLIC_APP_ENV=local

# Optional simple password protection for the internal dashboard.
# Leave DASHBOARD_PASSWORD blank for local testing.
DASHBOARD_USERNAME=horizon
DASHBOARD_PASSWORD=

# Supabase project settings.
# Use these only after creating the Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

